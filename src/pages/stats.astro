---
import { store } from '../../api/index.js';

// Build-time snapshot (offline fallback); the inline script replaces these
// numbers with live GET /stats data — no chart lib, hand-rolled inline SVG.
const snap = {
  queued: store.queue.length,
  replayed: store.stats.synced,
  failed: store.stats.failed,
  duplicates: store.stats.duplicates,
  attempts: store.stats.syncAttempts,
  verified: store.profiles.size,
  consents: store.consents.length,
};
const title = '📊 फ़ील्ड आँकड़े — सहायक Grid';
---
<!doctype html>
<html lang="hi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#14532d" />
<style>
:root{--bg:#f7f5ef;--fg:#1a1a1a;--card:#ffffff;--brand:#166534;--line:#e2ddd0}
body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",sans-serif;line-height:1.6}
.wrap{max-width:760px;margin:0 auto;padding:12px 16px 96px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin:12px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{border:1px solid var(--line);border-radius:12px;padding:10px;text-align:center}
.stat b{font-size:1.6rem;display:block}
.bar{height:14px;border-radius:999px;background:var(--line);overflow:hidden;margin:4px 0 10px}
.bar > i{display:block;height:100%;background:var(--brand)}
footer.nav{position:fixed;bottom:0;left:0;right:0;background:var(--card);border-top:1px solid var(--line);display:flex}
footer.nav a{flex:1;text-align:center;padding:14px 4px;min-height:48px;text-decoration:none;color:var(--fg);font-weight:700}
.skip{position:absolute;left:-9999px}.skip:focus{left:8px;top:8px;background:#fff;padding:12px;z-index:99}
</style>
</head>
<body>
<a class="skip" href="#main">मुख्य सामग्री पर जाएँ</a>
<div class="wrap" id="main">
<h1>📊 फ़ील्ड आँकड़े</h1>
<p>ऑफ़लाइन सिंक का असर — हर <code>POST /sync</code> गिना जाता है। <span id="liveTag" role="status"></span></p>
<section class="card" aria-label="सिंक आँकड़े">
<h2>सिंक प्रभाव (sync impact)</h2>
<div id="svgWrap" role="img" aria-label="सिंक आँकड़ों का चार्ट">
<svg id="chart" viewBox="0 0 320 132" width="100%" aria-hidden="true">
<text x="0" y="14" font-size="12">पुनः भेजे (replayed)</text><rect x="0" y="20" width="320" height="14" rx="7" fill="var(--line)"/><rect id="bRep" x="0" y="20" height="14" rx="7" fill="#16a34a" width="0"/>
<text x="0" y="54" font-size="12">दोहराव (duplicates — idempotent)</text><rect x="0" y="60" width="320" height="14" rx="7" fill="var(--line)"/><rect id="bDup" x="0" y="60" height="14" rx="7" fill="#2563eb" width="0"/>
<text x="0" y="94" font-size="12">विफल (failed)</text><rect x="0" y="100" width="320" height="14" rx="7" fill="var(--line)"/><rect id="bFail" x="0" y="100" height="14" rx="7" fill="#b91c1c" width="0"/>
</svg>
</div>
<div class="grid">
<div class="stat"><b id="nAtt">{snap.attempts}</b>कुल प्रयास (attempts)</div>
<div class="stat"><b id="nRep">{snap.replayed}</b>पुनः भेजे (replayed)</div>
<div class="stat"><b id="nDup">{snap.duplicates}</b>दोहराव रोके (duplicates)</div>
<div class="stat"><b id="nFail">{snap.failed}</b>विफल (failed)</div>
<div class="stat"><b id="nQ">{snap.queued}</b>कतार में (queued)</div>
<div class="stat"><b id="nV">{snap.verified}</b>सत्यापित प्रोफ़ाइल</div>
</div>
<p><small>सहमति लॉग: <b id="nC">{snap.consents}</b> • डुप्लिकेट यानी idempotent replay ने सर्वर-स्थिति नहीं बिगाड़ी — यही ऑफ़लाइन प्रभाव का प्रमाण है।</small></p>
</section>
</div>
<footer class="nav" aria-label="नीचे नेविगेशन">
<a href="/">🏠 होम</a><a href="/alerts">⏰ अलर्ट</a><a href="/stats">📊 आँकड़े</a>
</footer>
<script>
'use strict';
function paint(s){ const set=(id,v)=>{document.getElementById(id).textContent=v;};
  set('nAtt',s.attempts); set('nRep',s.replayed); set('nDup',s.duplicates); set('nFail',s.failed); set('nQ',s.queued); set('nV',s.verified); set('nC',s.consents);
  const t=Math.max(1,s.attempts), W=320;
  document.getElementById('bRep').setAttribute('width',String(Math.round(W*(s.replayed/t))));
  document.getElementById('bDup').setAttribute('width',String(Math.round(W*(s.duplicates/t))));
  document.getElementById('bFail').setAttribute('width',String(Math.round(W*(s.failed/t)))); }
async function live(){ try{ const r=await fetch('/api/stats'); if(!r.ok) throw 0; const s=await r.json(); paint(s);
  document.getElementById('liveTag').textContent='✅ लाइव API से'; }catch(e){ document.getElementById('liveTag').textContent='○ ऑफ़लाइन — बिल्ड-समय स्नैपशॉट'; } }
paint({ attempts:+document.getElementById('nAtt').textContent||0, replayed:+document.getElementById('nRep').textContent||0, duplicates:+document.getElementById('nDup').textContent||0, failed:+document.getElementById('nFail').textContent||0, queued:+document.getElementById('nQ').textContent||0, verified:+document.getElementById('nV').textContent||0, consents:+document.getElementById('nC').textContent||0 });
live();
</script>
</body>
</html>
