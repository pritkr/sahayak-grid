---
import { SCHEMES } from '../data/schemes.js';

const title = 'सहायक Grid — ऑफ़लाइन नागरिक सहायता PWA';
const desc = 'बिहार की 8 योजनाएँ • हिंदी-फर्स्ट • ऑफ़लाइन • 48px टच • TTS • समय-सीमा अलर्ट';
---
<!doctype html>
<html lang="hi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#14532d" />
<style>
:root{--bg:#f7f5ef;--fg:#1a1a1a;--card:#ffffff;--brand:#166534;--brand2:#15803d;--warn:#b45309;--bad:#b91c1c;--line:#e2ddd0}
@media(prefers-color-scheme:dark){:root{--bg:#101410;--fg:#f1efe7;--card:#182018;--brand:#4ade80;--brand2:#22c55e;--line:#2c352c}}
html[data-theme="dark"]{--bg:#101410;--fg:#f1efe7;--card:#182018;--brand:#4ade80;--brand2:#22c55e;--line:#2c352c}
html[data-theme="light"]{--bg:#f7f5ef;--fg:#1a1a1a;--card:#ffffff;--brand:#166534;--brand2:#15803d;--line:#e2ddd0}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",sans-serif;line-height:1.6}
.wrap{max-width:760px;margin:0 auto;padding:12px 16px 96px}
header.top{position:sticky;top:0;background:var(--bg);padding:10px 0;border-bottom:2px solid var(--brand);z-index:5}
h1{font-size:1.5rem;margin:.2em 0}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin:12px 0}
button,.btn,input,select{min-height:48px;font-size:1rem;border-radius:12px}
button,.btn{background:var(--brand);color:#fff;border:0;padding:12px 18px;cursor:pointer;font-weight:700;width:100%}
button.ghost{background:transparent;color:var(--brand);border:2px solid var(--brand)}
input,select{width:100%;padding:12px;border:2px solid var(--line);background:var(--card);color:var(--fg)}
label{display:block;font-weight:700;margin:10px 0 4px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.badge{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.85rem;font-weight:700}
.u-urgent{background:#fef3c7;color:#92400e}.u-soon{background:#dcfce7;color:#166534}.u-over{background:#fee2e2;color:#991b1b}.u-ok{background:#e0e7ff;color:#3730a3}
.scheme h3{margin:.2em 0}
.offbar{padding:10px;border-radius:10px;font-weight:700;text-align:center}
.offbar.off{background:#fee2e2;color:#991b1b}.offbar.on{background:#dcfce7;color:#166534}
footer.nav{position:fixed;bottom:0;left:0;right:0;background:var(--card);border-top:1px solid var(--line);display:flex}
footer.nav a{flex:1;text-align:center;padding:14px 4px;min-height:48px;text-decoration:none;color:var(--fg);font-weight:700}
.skip{position:absolute;left:-9999px}.skip:focus{left:8px;top:8px;background:#fff;padding:12px;z-index:99}
.tts{width:auto;display:inline-block;padding:8px 14px;min-height:48px}
svg.chart{width:120px;height:120px}
</style>
</head>
<body>
<a class="skip" href="#main">मुख्य सामग्री पर जाएँ</a>
<header class="top"><div class="wrap" style="padding-bottom:4px">
<h1>🌾 सहायक Grid <small style="font-size:.9rem">ऑफ़लाइन PWA</small></h1>
<div id="netbar" class="offbar on" role="status">● ऑनलाइन</div>
</div></header>
<div class="wrap" id="main">
<main>
<section class="card" id="sec-register" aria-label="पंजीकरण">
<h2>1️⃣ एक बार पंजीकरण <button class="tts" data-say="एक बार पंजीकरण करें। नाम, आयु, और मोबाइल भरें।">🔊</button></h2>
<label for="name">नाम</label><input id="name" autocomplete="name" placeholder="जैसे — प्रीति कुमारी" />
<div class="row">
<div><label for="age">आयु</label><input id="age" type="number" min="0" max="100" value="21" /></div>
<div><label for="gender">लिंग</label><select id="gender"><option value="female">महिला</option><option value="male">पुरुष</option><option value="any">अन्य</option></select></div>
</div>
<div class="row">
<div><label for="income">वार्षिक आय (₹)</label><input id="income" type="number" value="120000" /></div>
<div><label for="mobile">मोबाइल</label><input id="mobile" inputmode="numeric" placeholder="10 अंक" /></div>
</div>
<div class="row">
<div><label for="student">विद्यार्थी?</label><select id="student"><option value="yes">हाँ</option><option value="no">नहीं</option></select></div>
<div><label for="farmer">किसान परिवार?</label><select id="farmer"><option value="no">नहीं</option><option value="yes">हाँ</option></select></div>
</div>
<label for="otp">OTP (डेमो: <code id="otpHint">—</code>)</label>
<div class="row"><div><input id="otp" inputmode="numeric" placeholder="6 अंक" /></div><div><button id="otpBtn" class="ghost" type="button">OTP भेजें</button></div></div>
<label><input type="checkbox" id="consent" style="width:24px;height:24px;vertical-align:middle" /> मैं सहमति देता/देती हूँ (consent log ऑफ़लाइन सहेजा जाएगा)</label>
<button id="regBtn" type="button">रजिस्टर करें → पात्रता देखें</button>
<p id="regMsg" role="status"></p>
</section>

<section class="card" id="sec-search" aria-label="खोज">
<h2>2️⃣ योजना खोजें <button class="tts" data-say="योजना खोजें। हिंदी या रोमन में लिखें, जैसे कन्या, आवास, या लोन।">🔊</button></h2>
<label for="q">खोज (जैसे: कन्या / kanya / awas / loan)</label>
<input id="q" type="search" placeholder="कन्या, आवास, किसान, loan…" />
<div id="results" aria-live="polite"></div>
</section>

<section class="card" id="sec-eligible" aria-label="पात्रता">
<h2>3️⃣ मेरी पात्रता + विश्लेषण</h2>
<div class="row"><div id="donutWrap"></div><div><p id="eligSummary" role="status">पहले पंजीकरण करें।</p><p id="benefitLine"></p></div></div>
<div id="eligList"></div>
</section>

<section class="card" id="sec-sync" aria-label="सिंक">
<h2>4️⃣ ऑफ़लाइन सिंक कतार</h2>
<p>हवाई जहाज़ मोड में रजिस्टर करें — लेख <em>कतार</em> में सहेजा जाएगा, नेट आते ही भेजा जाएगा।</p>
<p>कतार में: <strong id="qCount">0</strong> <button id="syncBtn" class="ghost" type="button">अभी सिंक करें</button></p>
<p id="syncMsg" role="status"></p>
<button id="themeBtn" class="ghost" type="button">🌙/☀️ थीम बदलें</button>
</section>

<section class="card"><h2>⏰ समय-सीमा + 📊 आँकड़े (v2)</h2>
<p>नज़दीकी डेडलाइन <a href="/alerts">अलर्ट पेज</a> पर tier-क्रम में (critical ≤7 दिन → soon ≤30 दिन → खुला), और ऑफ़लाइन सिंक का असर <a href="/stats">आँकड़े पेज</a> पर लाइव SVG चार्ट में।</p>
</section>

<section class="card"><h2>सभी 8 योजनाएँ (सीड डेटा)</h2>
{SCHEMES.map(s => (
<div class="scheme" style="border-top:1px solid var(--line);padding:8px 0">
<h3>{s.name_hi}</h3>
<p><small>{s.name_en} • {s.dept_hi}</small></p>
<p>{s.benefit_hi}</p>
</div>
))}
</section>
</main>
</div>
<footer class="nav" aria-label="नीचे नेविगेशन">
<a href="#sec-register">📝 रजिस्टर</a><a href="#sec-search">🔍 खोज</a><a href="/alerts">⏰ अलर्ट</a><a href="/stats">📊 आँकड़े</a>
</footer>
<script id="seed" type="application/json" set:html={JSON.stringify(SCHEMES)} />
<script>
'use strict';
// ---- inline idb-keyval-lite + localStorage fallback ----
const K = { p:'sg:profile', q:'sg:queue', c:'sg:consent' };
const mem = {};
async function kvGet(k){ try{ if(window.indexedDB){ const v = await idbGet(k); if(v!=null) return v; } }catch(e){} try{ const l = localStorage.getItem(k); if(l!=null) return l; }catch(e){} return mem[k] ?? null; }
async function kvSet(k,v){ try{ if(window.indexedDB){ await idbSet(k,v); return; } }catch(e){} try{ localStorage.setItem(k,v); return; }catch(e){} mem[k]=v; }
function idb(){ return new Promise((res,rej)=>{ const r=indexedDB.open('sahayak-grid',1); r.onupgradeneeded=()=>r.result.createObjectStore('kv'); r.onsuccess=()=>res(r.result); r.onerror=()=>rej(r.error); }); }
function idbGet(k){ return idb().then(db=>new Promise((res,rej)=>{ const t=db.transaction('kv','readonly'); const q=t.objectStore('kv').get(k); q.onsuccess=()=>res(q.result??null); q.onerror=()=>rej(q.error); })); }
function idbSet(k,v){ return idb().then(db=>new Promise((res,rej)=>{ const t=db.transaction('kv','readwrite'); t.objectStore('kv').put(v,k); t.oncomplete=()=>res(); t.onerror=()=>rej(t.error); })); }
const SEED = JSON.parse(document.getElementById('seed').textContent);
const FOLD = [[/kanya|kanyaa/g,'कन्या'],[/beti|betee|ladki|ladkee/g,'बेटी'],[/awas|aawas/g,'आवास'],[/kisan|kisaan/g,'किसान'],[/chhatra|chatra/g,'छात्र'],[/rojgar|rozgar/g,'रोजगार'],[/rin|loan|karz/g,'ऋण'],[/snatak|graduate/g,'स्नातक'],[/mahila|aurat|women|woman/g,'महिला'],[/ghar|makaan|makan|housing|home/g,'घर'],[/shiksha|education|padhai/g,'शिक्षा'],[/yojana|yojna|scheme/g,'योजना']];
function norm(s){ return (s||'').toLowerCase().normalize('NFC').replace(/[^a-z\u0900-\u097F0-9\s]/g,'').replace(/\s+/g,' ').trim(); }
function fold(s){ let x=' '+s+' '; for(const [re,d] of FOLD) x=x.replace(re,d); return x; }
function search(q){ const nq=norm(q); if(!nq) return SEED; const toks=fold(nq).split(' ').filter(Boolean); return SEED.map(s=>{ const hay=norm([s.name_hi,s.name_en,s.dept_hi,s.benefit_hi,s.benefit_en,...s.tags_hi,...s.tags_en,...s.keywords].join(' ')+' '+fold(([s.name_en,...s.tags_en,...s.keywords].join(' ')).toLowerCase())); let sc=0; for(const t of toks) if(hay.includes(t)) sc+=t.length>=4?2:1; return {s,sc}; }).filter(x=>x.sc>0).sort((a,b)=>b.sc-a.sc).map(x=>x.s); }
function elig(s,p){ const e=s.eligibility,r=[]; if(!p.domBihar&&e.biharDomicile) r.push('बिहार निवासी आवश्यक'); if(e.minAge!=null&&p.age<e.minAge) r.push('आयु '+e.minAge+'+ चाहिए'); if(e.maxAge!=null&&p.age>e.maxAge) r.push('आयु '+e.maxAge+' तक'); if(e.genders&&!e.genders.includes('any')&&!e.genders.includes(p.gender)) r.push('लिंग शर्त'); if(e.maxIncome!=null&&p.income>e.maxIncome) r.push('आय ₹'+e.maxIncome.toLocaleString('en-IN')+' से कम'); if(e.studentOnly&&!p.student) r.push('केवल विद्यार्थी'); if(e.farmerOnly&&!p.farmer) r.push('केवल किसान'); return r; }
function daysLeft(d){ const dl=new Date(d+'T23:59:59'); return Math.ceil((dl-Date.now())/864e5); }
function uClass(d){ if(d<0) return 'u-over'; if(d<=7) return 'u-urgent'; if(d<=30) return 'u-soon'; return 'u-ok'; }
function uLabel(d){ if(d<0) return 'समय समाप्त'; if(d<=7) return 'सिर्फ '+d+' दिन बचे!'; return d+' दिन बचे'; }
function esc(s){ return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function card(s,showWhy,why){ const d=daysLeft(s.deadline); return '<article class="scheme card" style="margin:8px 0"><h3>'+esc(s.name_hi)+'</h3><p><small>'+esc(s.name_en)+' • '+esc(s.dept_hi)+'</small></p><p>'+esc(s.benefit_hi)+'</p><p><span class="badge '+uClass(d)+'">⏳ '+esc(s.deadline)+' • '+uLabel(d)+'</span> '+(s.amount?' <span class="badge u-soon">₹'+Number(s.amount).toLocaleString('en-IN')+'</span>':'')+'</p>'+(showWhy?(why.length?'<p>✅ <strong>पात्र</strong></p>':'<p>❌ '+esc(why.join(', ')||'')+'</p>'):'')+'<div class="row"><button class="tts" data-say="'+esc(s.name_hi+'. '+s.benefit_hi)+'">🔊 सुनें</button><button class="ghost remind" data-id="'+s.id+'">🔔 याद दिलाएँ</button></div></article>'; }
async function render(q){ const list=search(q||''); document.getElementById('results').innerHTML=list.length?list.slice(0,12).map(s=>card(s,false,[])).join(''):'<p>कोई योजना नहीं मिली। "kanya" या "awas" लिखकर देखें।</p>'; bindTTS(); bindRemind(); }
async function renderElig(){ const raw=await kvGet(K.p); if(!raw) return; const p=JSON.parse(raw); const rows=SEED.map(s=>({s,w:elig(s,p)})); const ok=rows.filter(r=>!r.w.length); const no=rows.filter(r=>r.w.length); document.getElementById('eligSummary').textContent='✅ '+ok.length+' योजनाओं हेतु पात्र • ❌ '+no.length+' हेतु अपात्र'; const tot=ok.reduce((a,r)=>a+(r.s.amount||0),0); document.getElementById('benefitLine').textContent=tot?('संभावित लाभ: ₹'+tot.toLocaleString('en-IN')):'सेवा-आधारित लाभ उपलब्ध'; document.getElementById('donutWrap').innerHTML=donut(ok.length,no.length); document.getElementById('eligList').innerHTML=ok.map(r=>card(r.s,true,r.w)).join('')+no.map(r=>card(r.s,true,r.w)).join(''); bindTTS(); bindRemind(); }
function donut(a,b){ const t=(a+b)||1, f=a/t; const r=40,c=50; const ang=(-90+f*360)*Math.PI/180, a0=-Math.PI/2; const x0=c+r*Math.cos(a0),y0=c+r*Math.sin(a0),x1=c+r*Math.cos(ang),y1=c+r*Math.sin(ang); const large=f>0.5?1:0; const p=f<=0?'':f>=1?'':'M 50 50 L '+x0.toFixed(1)+' '+y0.toFixed(1)+' A 40 40 0 '+large+' 1 '+x1.toFixed(1)+' '+y1.toFixed(1)+' Z'; return '<svg class="chart" viewBox="0 0 100 100" role="img" aria-label="पात्र '+a+', अपात्र '+b+'"><circle cx="50" cy="50" r="40" fill="#fee2e2"/><path d="'+p+'" fill="#16a34a"/><text x="50" y="55" text-anchor="middle" font-size="16" font-weight="bold" fill="currentColor">'+a+'/'+t+'</text></svg>'; }
function speak(t){ try{ speechSynthesis.cancel(); const u=new SpeechSynthesisUtterance(t); u.lang='hi-IN'; const v=speechSynthesis.getVoices().find(v=>v.lang&&v.lang.startsWith('hi')); if(v) u.voice=v; speechSynthesis.speak(u); }catch(e){ alert(t); } }
function bindTTS(){ document.querySelectorAll('.tts').forEach(b=>b.onclick=()=>speak(b.dataset.say||b.textContent)); }
function bindRemind(){ document.querySelectorAll('.remind').forEach(b=>b.onclick=async()=>{ const s=SEED.find(x=>x.id===b.dataset.id); const d=daysLeft(s.deadline); try{ if(Notification&&Notification.permission==='default') await Notification.requestPermission(); }catch(e){} speak(s.name_hi+'. अंतिम तिथि '+s.deadline+'. '+uLabel(d)); alert('🔔 '+s.name_hi+'\nअंतिम तिथि: '+s.deadline+' ('+uLabel(d)+')'); }); }
// net status + queue
async function qGet(){ const r=await kvGet(K.q); try{ return r?JSON.parse(r):[]; }catch(e){ return []; } }
async function qSet(q){ await kvSet(K.q,JSON.stringify(q)); document.getElementById('qCount').textContent=q.length; }
async function refreshQ(){ document.getElementById('qCount').textContent=(await qGet()).length; }
function net(){ const on=navigator.onLine; const b=document.getElementById('netbar'); b.textContent=on?'● ऑनलाइन':'○ ऑफ़लाइन — लेख कतार में सहेजे जाएँगे'; b.className='offbar '+(on?'on':'off'); }
window.addEventListener('online',async()=>{ net(); await syncNow(); });
window.addEventListener('offline',net);
async function syncNow(){ const q=await qGet(); if(!q.length){ document.getElementById('syncMsg').textContent='कतार खाली है ✅'; return; } if(!navigator.onLine){ document.getElementById('syncMsg').textContent='ऑफ़लाइन हैं — '+q.length+' लेख कतार में सुरक्षित।'; return; } let sent=0; const left=[]; for(const op of q){ try{ const r=await fetch('/api/sync',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(op)}); if(r.ok) sent++; else left.push(op); }catch(e){ left.push(op); try{ await fetch(window.API_BASE+'/sync',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(op)}); sent++; left.pop(); }catch(e2){} } } await qSet(left); document.getElementById('syncMsg').textContent=sent?('✅ '+sent+' लेख सिंक हुए'):'सर्वर नहीं मिला — डेमो मोड में कतार साफ की गई'; if(!left.length||document.getElementById('syncMsg').textContent.includes('डेमो')){ await qSet([]); } await renderElig(); }
// register + mock OTP
let OTP='';
document.getElementById('otpBtn').onclick=()=>{ OTP=String(Math.floor(100000+Math.random()*900000)); document.getElementById('otpHint').textContent=OTP+' (डेमो)'; speak('आपका OTP है '+OTP.split('').join(' ')); };
document.getElementById('regBtn').onclick=async()=>{ const p={ name:document.getElementById('name').value.trim(), age:+document.getElementById('age').value||0, gender:document.getElementById('gender').value, income:+document.getElementById('income').value||0, mobile:document.getElementById('mobile').value.trim(), student:document.getElementById('student').value==='yes', farmer:document.getElementById('farmer').value==='yes', domBihar:true }; const m=document.getElementById('regMsg'); if(!p.name){ m.textContent='कृपया नाम लिखें।'; return; } if(!/^[6-9]\d{9}$/.test(p.mobile)){ m.textContent='मोबाइल 10 अंक (6-9 से शुरू) लिखें।'; return; } if(!document.getElementById('consent').checked){ m.textContent='कृपया सहमति टिक करें।'; return; } const otpIn=document.getElementById('otp').value.trim(); if(OTP&&otpIn!==OTP){ m.textContent='OTP गलत है। डेमो OTP: '+OTP; return; } await kvSet(K.p,JSON.stringify(p)); await kvSet(K.c,JSON.stringify({mobile:p.mobile,at:new Date().toISOString(),text:'consent-hi-v1'})); const q=await qGet(); q.push({id:'q_'+Date.now(),type:'register',payload:p,createdAt:new Date().toISOString(),attempts:0}); await qSet(q); m.textContent='✅ पंजीकरण सहेजा गया'+(navigator.onLine?'':' (ऑफ़लाइन — कतार में)')+'। पात्रता नीचे देखें।'; speak('पंजीकरण हो गया। '+p.name+', आपकी पात्रता नीचे दिख रही है।'); await renderElig(); if(navigator.onLine) await syncNow(); };
document.getElementById('q').oninput=e=>render(e.target.value);
document.getElementById('syncBtn').onclick=syncNow;
document.getElementById('themeBtn').onclick=()=>{ const h=document.documentElement; h.dataset.theme=h.dataset.theme==='dark'?'light':'dark'; try{localStorage.setItem('sg:theme',h.dataset.theme);}catch(e){} };
try{ const t=localStorage.getItem('sg:theme'); if(t) document.documentElement.dataset.theme=t; }catch(e){}
if('serviceWorker' in navigator) window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));
net(); render(''); refreshQ(); renderElig();
</script>
</body>
</html>
